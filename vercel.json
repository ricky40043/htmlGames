{
  "version": 2,
  "name": "mini-games-collection",
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.mp3",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/bomb-topic",
      "destination": "/bomb-topic/index.html"
    },
    {
      "source": "/guess-number",
      "destination": "/guess-number/index.html"
    },
    {
      "source": "/1A2B",
      "destination": "/1A2B/index.html"
    },
    {
      "source": "/two-types-people",
      "destination": "/two-types-people/index.html"
    },
    {
      "source": "/two-player-quiz",
      "destination": "/two-player-quiz/index.html"
    },
    {
      "source": "/who-is-spy",
      "destination": "/who-is-spy/index.html"
    },
    {
      "source": "/2048",
      "destination": "/CascadeProjects/2048/index.html"
    }
  ],
  "headers": [
    {
      "source": "**/*.mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
